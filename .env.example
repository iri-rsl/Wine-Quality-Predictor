# Copy to .env (never commit .env). Read by the API at runtime.
# dummy | mlflow
MODEL_SOURCE=dummy
MLFLOW_TRACKING_URI=https://dagshub.com/iri-rsl/Wine-Quality-Predictor.mlflow
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
MLFLOW_MODEL_NAME=WineQualityPredictor
MLFLOW_MODEL_ALIAS=champion
# Only used if the registered model has no signature
# MODEL_FEATURES=fixed_acidity,volatile_acidity,citric_acid,residual_sugar,chlorides,free_sulfur_dioxide,total_sulfur_dioxide,density,pH,sulphates,alcohol
# Protects POST /admin/reload-model
ADMIN_TOKEN=change-me
DATABASE_PATH=var/app.db
